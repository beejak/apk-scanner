{
  "description": "Allowlist ONLY — educational/training downloads for weekly Actions sandbox and local capability runs. Not an internet crawl. Edit via PR to add/remove URLs.",
  "max_artifacts": 15,
  "notes": [
    "Prefer small public training APKs/IPAs, Maven JARs, generated SDK trees, and .so extracted from allowlisted APKs.",
    "primary is tried first; fallback fills the quota when primary entries are skipped (already scanned at same version) or fail.",
    "Scan history (tests/fixtures/scan_history.json) records id+version/etag/sha256 — commit history JSON, never binaries.",
    "If a URL 404s, the weekly job logs and continues (does not fail the repo).",
    "Never commit downloaded binaries; reports only under docs/results/weekly_*/."
  ],
  "schema": {
    "entry_fields": [
      "id",
      "name",
      "type (apk|ipa|jar|so|sdk)",
      "url or urls",
      "version or content_fingerprint",
      "publisher (optional)",
      "notes (optional)",
      "force (optional bool)",
      "min_interval_days (optional int)"
    ],
    "sdk": "Either a https zip URL, or { \"generate\": true, \"files\": [{\"path\", \"content\"}] } which creates a tiny sample_sdk tree in TEMP (no binary commit).",
    "so": "Either a public https direct URL, or extract_from_apk: { \"url\", \"member\" } (download APK to temp, extract .so, delete APK)."
  },
  "primary": [
    {
      "id": "insecureshop-apk",
      "type": "apk",
      "name": "InsecureShop.apk",
